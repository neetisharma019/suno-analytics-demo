    de.user_id,
    de.event_date,
    u.signup_date,
    de.songs_generated,
    de.songs_exported,
    de.songs_extended,
    de.unique_songs,
    de.unique_sessions,
    de.total_duration_sec
from daily_events de
left join users u
    on de.user_id = u.user_id
    );
  
  
